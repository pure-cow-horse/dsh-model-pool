{
  "name": "dsh-model-pool",
  "version": "0.1.1",
  "description": "DSH 插件：探测供应商上游模型并测试有效性，勾选模型组建多方案故障转移链路，自带顺延引擎接管。",
  "license": "MIT",
  "scripts": {
    "probe": "node probes/run-all.mjs"
  },
  "author": "pure-cow-horse",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "model-pool",
    "failover",
    "load-balancing"
  ],
  "homepage": "https://github.com/pure-cow-horse/dsh-model-pool#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pure-cow-horse/dsh-model-pool.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/client.js",
    "dist/index.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1-rc.1 <5.0.0 || >=4.0.2 <5.0.0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.3.0-0 || >=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2 <0.3.0-0 || >=0.2.2-rc.1 <0.3.0-0"
  }
}
